diff --git a/main/audio/audio_service.cc b/main/audio/audio_service.cc
index 7f7582b..3085710 100644
--- a/main/audio/audio_service.cc
+++ b/main/audio/audio_service.cc
@@ -1,4 +1,8 @@
 #include "audio_service.h"
+
+#if CONFIG_BT_A2DP_ENABLE
+#include "bt_a2dp_source.h"
+#endif
 #include <esp_log.h>
 #include <cstring>
 
@@ -348,7 +352,18 @@ void AudioService::AudioOutputTask() {
             callbacks_.on_playback_progress(task.playback_id, task.media_position_ms);
         }
 
+#if CONFIG_BT_A2DP_ENABLE
+        /* A connected Bluetooth speaker takes the audio and paces playback itself,
+           because xRingbufferSend blocks while the sink is still draining. */
+        auto& bluetooth = BtA2dpSource::GetInstance();
+        if (bluetooth.TakesAudio(task.playback_id != 0)) {
+            bluetooth.WritePcm(task.pcm.data(), task.pcm.size(), codec_->output_sample_rate());
+        } else {
+            codec_->OutputData(task.pcm);
+        }
+#else
         codec_->OutputData(task.pcm);
+#endif
 
         /* Update the last output time */
         last_output_time_ = std::chrono::steady_clock::now();
diff --git a/main/boards/bread-compact-esp32-lcd/esp32_bread_board_lcd.cc b/main/boards/bread-compact-esp32-lcd/esp32_bread_board_lcd.cc
