@@ -85,7 +85,10 @@ private:
         io_config.cs_gpio_num = DISPLAY_CS_PIN;
         io_config.dc_gpio_num = DISPLAY_DC_PIN;
         io_config.spi_mode = DISPLAY_SPI_MODE;
-        io_config.pclk_hz = 40 * 1000 * 1000;
+        // The ST7735S tops out near 15 MHz, and on this board the clock and data pins are
+        // not the SPI3 native ones, so they run through the GPIO matrix. 10 MHz still
+        // redraws 128x160 about 30 times a second and survives breadboard jumpers.
+        io_config.pclk_hz = 10 * 1000 * 1000;
         io_config.trans_queue_depth = 10;
         io_config.lcd_cmd_bits = 8;
         io_config.lcd_param_bits = 8;
