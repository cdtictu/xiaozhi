+static bool ToV4l2Format(pixformat_t format, v4l2_pix_fmt_t& out) {
+    switch (format) {
+        case PIXFORMAT_RGB565:
+            out = V4L2_PIX_FMT_RGB565;
+            return true;
+        case PIXFORMAT_YUV422:
+            out = V4L2_PIX_FMT_YUYV;  // YUV422 is actually YUYV format
+            return true;
+        case PIXFORMAT_YUV420:
+            out = V4L2_PIX_FMT_YUV420;
+            return true;
+        case PIXFORMAT_GRAYSCALE:
+            out = V4L2_PIX_FMT_GREY;
+            return true;
+        case PIXFORMAT_JPEG:
+            out = V4L2_PIX_FMT_JPEG;
+            return true;
+        case PIXFORMAT_RGB888:
+            out = V4L2_PIX_FMT_RGB24;
+            return true;
+        default:
+            return false;
+    }
+}
+
+std::expected<std::string, std::string> Esp32Camera::GetJpeg(int quality) {
+    if (current_fb_ == nullptr) {
+        return std::unexpected("No camera frame captured");
+    }
+    if (current_fb_->format == PIXFORMAT_JPEG) {
+        return std::string(reinterpret_cast<const char*>(current_fb_->buf), current_fb_->len);
+    }
+
+    v4l2_pix_fmt_t enc_fmt;
+    if (!ToV4l2Format(current_fb_->format, enc_fmt)) {
+        return std::unexpected("Unsupported pixel format");
+    }
+
+    // Use encode buffer for RGB565 (byte order fixed in Capture), otherwise the frame buffer
+    uint8_t* src = current_fb_->buf;
+    size_t src_len = current_fb_->len;
+    if (current_fb_->format == PIXFORMAT_RGB565 && encode_buf_ != nullptr) {
+        src = encode_buf_;
+        src_len = encode_buf_size_;
+    }
+
+    uint8_t* jpeg = nullptr;
+    size_t jpeg_len = 0;
+    if (!image_to_jpeg(src, src_len, current_fb_->width, current_fb_->height, enc_fmt,
+                       static_cast<uint8_t>(quality), &jpeg, &jpeg_len) ||
+        jpeg == nullptr) {
+        return std::unexpected("Failed to encode image to JPEG");
+    }
+    std::string result(reinterpret_cast<const char*>(jpeg), jpeg_len);
+    free(jpeg);
+    return result;
+}
