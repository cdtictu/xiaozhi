 #define TAG "Application"
 
+// StartNotification() only accepts a song when the device is idle and the previous
+// stream has closed, so a pending song is retried for about 30 seconds.
+static constexpr uint64_t kPendingAudioRetryUs = 200 * 1000;
+static constexpr int kMaxPendingAudioRetries = 150;
+
+void Application::PlayAudioUrl(const std::string& url) {
+    Schedule([this, url]() {
+        pending_audio_url_ = url;
+        pending_audio_retries_ = 0;
+        auto state = GetDeviceState();
+        if (state == kDeviceStateNotifying) {
+            // Replace the current song: the idle handler starts the new one
+            StopNotification();
+        } else if (state == kDeviceStateIdle) {
+            StartPendingAudio();
+        }
+        // In a conversation the listening handler ends it first
+    });
+}
+
+void Application::StopAudioUrl() {
+    Schedule([this]() {
+        pending_audio_url_.clear();
+        if (pending_audio_timer_ != nullptr) {
+            esp_timer_stop(pending_audio_timer_);
+        }
+        // Always stop the player: the stream keeps running even if the state moved on
+        StopNotification();
+    });
+}
+
+void Application::StartPendingAudio() {
+    if (pending_audio_url_.empty()) {
+        return;
+    }
+    // Keep the URL while the device is busy: dropping it would lose the song silently
+    auto retry = [this]() {
+        if (++pending_audio_retries_ > kMaxPendingAudioRetries) {
+            ESP_LOGW(TAG, "Giving up on the pending song: the device stayed busy");
+            pending_audio_url_.clear();
+            return;
+        }
+        if (pending_audio_timer_ == nullptr) {
+            esp_timer_create_args_t args = {
+                .callback =
+                    [](void* arg) {
+                        auto app = static_cast<Application*>(arg);
+                        app->Schedule([app]() { app->StartPendingAudio(); });
+                    },
+                .arg = this,
+                .dispatch_method = ESP_TIMER_TASK,
+                .name = "pending_audio",
+                .skip_unhandled_events = true};
+            esp_timer_create(&args, &pending_audio_timer_);
+        }
+        esp_timer_start_once(pending_audio_timer_, kPendingAudioRetryUs);
+    };
+
+    if (GetDeviceState() != kDeviceStateIdle || notify_player_.IsBusy()) {
+        retry();
+        return;
+    }
+
+    std::string url = pending_audio_url_;
+    StartNotification(url, {});
+    if (GetDeviceState() == kDeviceStateNotifying) {
+        pending_audio_url_.clear();
+    } else {
+        retry();  // Refused after all
+    }
+}
